from Bio import SeqIO

input_file = "raw_pathogen.fastq"
output_file = "clean_pathogen.fastq"


total_reads = 0
good_reads = 0

# Открываем исходный файл на чтение, а новый — на запись
with open(output_file, "w") as clean_handle:
    
    # SeqIO.parse берет файл и автоматически превращает каждый рид в объект record
    for record in SeqIO.parse(input_file, "fastq"):
        total_reads += 1
        
       #тут автоматически вычисляем качество Фрэда для прочтения ридов и находим среднее качество прочтения на весь пул ридов
        scores = record.letter_annotations["phred_quality"]
        average_q = sum(scores) / len(scores)
        
        # Применяем логику фильтрации: золотой стандарт >= 30
        if average_q >= 30:
            good_reads += 1
            # Записываем хороший рид в наш чистый файл
            SeqIO.write(record, clean_handle, "fastq")

# Выводим статистику эксперимента
print(f"Обработка завершена!")
print(f"Всего ридов от секвенатора: {total_reads}")
print(f"Прошли контроль качества (Q >= 30): {good_reads}")
print(f"Отсеяно грязных ридов: {total_reads - good_reads}")
