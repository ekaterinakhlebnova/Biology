def peptide(rna):
    codon_table = {
        "AUG": "M", "GUA": "V", "CAG": "Q", 
        "GAA": "E", "CCA": "P", "UGC": "C",
        "UAA": "STOP", "UAG": "STOP", "UGA": "STOP"
    }
    peptide_str = ''
    
    for i in range(0, len(rna), 3):
        codon = rna[i:i+3] # Берем сразу 3 буквы (например, 'AUG')
        
        # Проверяем, не СТОП-кодон ли это
        if codon_table[codon] == "STOP":
            break # Прерываем цикл, трансляция окончена
            
        peptide_str += codon_table[codon] # Добавляем аминокислоту по ключу в []
        
    return peptide_str

# Тест:
print(peptide("AUGGUACAGGAACCANGCUAA")) # Выведет: MVQEPC
